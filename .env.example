# Use a long random alphanumeric value; keep this file as .env on the server only.
POSTGRES_PASSWORD=replace_with_random_alphanumeric_password
SESSION_SECRET=replace_with_at_least_32_random_characters

# Start with :80 for IP-only testing. After DNS and any required filing are ready,
# replace with the real domain, for example learn.example.com, to enable HTTPS.
SITE_ADDRESS=:80
SESSION_COOKIE_SECURE=false
